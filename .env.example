# Copy outside the repository. Use a unique project name, port and secrets for each deployment.
APP_ENV=dev
APP_PORT=51000
SOCKET_PORT=51001
APP_URL=https://app.example.com
MEDIA_BASE_URL=https://media.example.com
POSTGRES_USER=beacon
POSTGRES_DB=beacon
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
INITIAL_ADMIN_EMAILS=
MAIL_PROVIDER=resend
EMAIL_FROM=
RESEND_API_KEY=
# Generate once per environment; keep the private key outside the repository.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# HTTPS contact URL or mailto address. Defaults to APP_URL.
VAPID_SUBJECT=

# Optional container path; defaults to storage below MEDIA_ROOT.
# Mount a persistent directory there through an external Compose override.
STORAGE_ROOT=/data/media/storage
# Storage definitions use container paths. Bind mounts belong in an external Compose override.
# Omit personal_parent for a shared storage; personal_parent creates user-<UUID> roots.
STORAGES_JSON='[{"id":"home","name":"Домашнее","path":"/data/media/storage","mode":"local","personal_parent":"users"}]'
