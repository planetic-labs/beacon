{
  "name": "beacon",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "tsx watch apps/api/src/server.ts --dev",
    "build": "pnpm typecheck && pnpm --filter @beacon/web build",
    "start": "tsx apps/api/src/server.ts",
    "realtime": "tsx scripts/realtime.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "typecheck": "tsc --noEmit",
    "deps:check": "node scripts/check-dependencies.mjs",
    "test": "tsx --test tests/*.test.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "drizzle-kit": "0.31.11",
    "fastify": "5.12.7",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "@better-auth/oauth-provider": "1.7.14",
    "@better-auth/passkey": "1.7.14",
    "better-auth": "1.7.14",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "uuid": "14.0.3",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  }
}
